# ===========================================
# AfroMuziki — Environment Variables
# Copy to .env.local and fill with REAL values
# NEVER commit .env.local or any real secrets
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AfroMuziki
NEXT_PUBLIC_CONTACT_EMAIL=info.afromuziki@gmail.com

# ---------- Supabase ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project Settings → API → service_role (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- Cloudinary ----------
# Dashboard → Account Details
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz  # SERVER ONLY

# ---------- Brevo ----------
# SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=info.afromuziki@gmail.com
BREVO_SENDER_NAME=AfroMuziki

